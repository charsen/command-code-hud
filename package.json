{
  "name": "command-code-hud",
  "version": "0.1.0",
  "type": "module",
  "description": "A persistent Claude HUD-style heads-up display for Command Code.",
  "author": "Command Code HUD Contributors",
  "license": "MIT",
  "keywords": [
    "command-code",
    "cmd-mod",
    "statusline",
    "hud",
    "context",
    "tokens"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/charsen/command-code-hud.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "src",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "commandcode": {
    "mods": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
